{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["features", "reference_window", "min_reference_dates", "view"],
  "properties": {
    "features": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "feature_weights": {"type": "object", "additionalProperties": {"type": "number", "exclusiveMinimum": 0}},
    "weight_column": {"type": ["string", "null"]},
    "group_column": {"type": ["string", "null"]},
    "reference_window": {"type": "integer", "minimum": 1},
    "min_reference_dates": {"type": "integer", "minimum": 1},
    "min_cross_section": {"type": "integer", "minimum": 2},
    "view": {"enum": ["industry_neutral", "global_cross_section"]}
  },
  "additionalProperties": false
}
